{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./renderer/*"]
    }
  },
  "include": ["**/*.ts", "../renderer/types/window.ts"]
}
