{
    "manifest_version": 3,
    "name": "Bifurc Companion",
    "version": "1.0.0",
    "description": "Proxy toggle and DevTools integration for Bifurc",
    "permissions": [
        "proxy",
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "devtools_page": "devtools.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "minimum_chrome_version": "126"
}