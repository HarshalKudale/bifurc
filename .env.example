# Copy to `.env` (untracked). Read by packages/engine-rust/build.rs and compiled into the engine.
# The client id of the GitHub OAuth app sign-in runs as (device flow enabled).
BIFURC_GITHUB_CLIENT_ID=
# The PostHog project usage analytics go to. Without a key the engine sends nothing.
BIFURC_POSTHOG_KEY=
# Optional: the PostHog host, when it is not https://us.i.posthog.com.
BIFURC_POSTHOG_HOST=
# Optional: the Bifurc Console that says who was given a shared workspace, when it is not
# https://console.bifurc.app.
BIFURC_CONSOLE_URL=
