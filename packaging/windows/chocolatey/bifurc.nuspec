<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>bifurc</id>
    <version>{{VERSION}}</version>
    <title>Bifurc</title>
    <authors>{{PUBLISHER}}</authors>
    <owners>{{PUBLISHER}}</owners>
    <projectUrl>{{HOMEPAGE}}</projectUrl>
    <packageSourceUrl>{{REPO_URL}}/tree/master/packaging/windows/chocolatey</packageSourceUrl>
    <projectSourceUrl>{{REPO_URL}}</projectSourceUrl>
    <bugTrackerUrl>{{REPO_URL}}/issues</bugTrackerUrl>
    <licenseUrl>{{LICENSE_URL}}</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <iconUrl>{{ICON_URL}}</iconUrl>
    <tags>bifurc api-client proxy mock localhost grpc graphql rest</tags>
    <summary>{{SUMMARY}}</summary>
    <description>{{DESCRIPTION}}</description>
    <releaseNotes>{{REPO_URL}}/releases/tag/{{TAG}}</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
