<?xml version="1.0" encoding="utf-8"?>
<!--
  The Store package: the same folder the installer ships. The identity is the Electron build's, so the Store
  listing upgrades in place. `bifurc.exe` is an execution alias, which is how a packaged app puts a command on
  PATH.
-->
<Package
   xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
   xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
   xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
   xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
   xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
   IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="HarshalKudale.Bifurc"
    ProcessorArchitecture="{{ARCH}}"
    Publisher="CN=C594A390-264F-4DE0-ABF9-524B641E479D"
    Version="{{VERSION}}" />
  <Properties>
    <DisplayName>Bifurc</DisplayName>
    <PublisherDisplayName>Harshal Kudale</PublisherDisplayName>
    <Description>Local development panel - localhost domain proxy manager</Description>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="Bifurc" Executable="bifurc-ui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
       BackgroundColor="transparent"
       DisplayName="Bifurc"
       Square150x150Logo="assets\Square150x150Logo.png"
       Square44x44Logo="assets\Square44x44Logo.png"
       Description="Local development panel - localhost domain proxy manager">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="bin\bifurc.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="bifurc.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
    <!-- A package may declare the appExecutionAlias extension only once per application, so the MCP server
         command is an application of its own, kept out of the Start menu. -->
    <Application Id="BifurcMcp" Executable="bin\bifurc-mcp.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
       AppListEntry="none"
       BackgroundColor="transparent"
       DisplayName="Bifurc MCP server"
       Square150x150Logo="assets\Square150x150Logo.png"
       Square44x44Logo="assets\Square44x44Logo.png"
       Description="Bifurc MCP server">
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="bin\bifurc-mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="bifurc-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
