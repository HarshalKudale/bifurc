{
    "version": "{{VERSION}}",
    "description": "{{SUMMARY}}",
    "homepage": "{{HOMEPAGE}}",
    "license": {
        "identifier": "Proprietary",
        "url": "{{LICENSE_URL}}"
    },
    "architecture": {
        "{{ARCH}}": {
            "url": "{{URL}}",
            "hash": "{{SHA256}}"
        }
    },
    "bin": ["bin\\bifurc.exe", "bin\\bifurc-mcp.exe"],
    "shortcuts": [
        [
            "bifurc-ui.exe",
            "Bifurc"
        ]
    ],
    "pre_uninstall": "& \"$dir\\bin\\bifurc.exe\" engine stop --no-start | Out-Null",
    "checkver": {
        "github": "{{REPO_URL}}"
    },
    "autoupdate": {
        "architecture": {
            "{{ARCH}}": {
                "url": "{{REPO_URL}}/releases/download/v$version/Bifurc-$version-win-{{FILE_ARCH}}.zip"
            }
        }
    }
}
