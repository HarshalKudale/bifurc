{
  "name": "github.ping",
  "about": "The GitHub ping sent when a webhook is created",
  "headers": {
    "Content-Type": "application/json",
    "User-Agent": "GitHub-Hookshot/bifurc",
    "X-GitHub-Event": "ping",
    "X-GitHub-Delivery": "{{hex:8}}-{{hex:4}}-{{hex:4}}-{{hex:4}}-{{hex:12}}"
  },
  "signatureHeader": "X-Hub-Signature-256",
  "payload": {
    "zen": "Keep it logically awesome.",
    "hook_id": 100000002,
    "hook": {
      "type": "Repository",
      "id": 100000002,
      "name": "web",
      "active": true,
      "events": [
        "push"
      ],
      "config": {
        "content_type": "json",
        "insecure_ssl": "0",
        "url": "https://example.com/webhooks/github"
      }
    },
    "repository": {
      "id": 100000001,
      "name": "demo",
      "full_name": "octo/demo",
      "private": false,
      "owner": {
        "login": "octo",
        "id": 1000001
      },
      "html_url": "https://github.com/octo/demo",
      "default_branch": "main"
    },
    "sender": {
      "login": "octocat",
      "id": 583231
    }
  }
}
